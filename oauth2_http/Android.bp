java_library_host {
    name: "google-auth-library-java-oauth2_http",
    srcs: [
        "java/**/*.java",
    ],
    libs: [
        "auto_value_annotations",
        "error_prone_annotations",
        "google-api-java-client-assembly",
        "google-auth-library-java-credentials",
        "guava",
    ],
    plugins: ["auto_value_plugin"],
    visibility: [
        "//external/google-auth-library-java:__subpackages__",
        "//external/grpc-grpc-java:__subpackages__",
        "//external/sdk-platform-java:__subpackages__",
        "//tools/apksig",
    ],
    errorprone: {
        javacflags: [
            "-Xep:DoubleBraceInitialization:WARN",
        ],
    },
    target: {
        windows: {
            enabled: true,
        },
    },
}
