java_library_host {
    name: "google-auth-library-java-credentials",
    srcs: [
        "java/**/*.java",
    ],
    visibility: [
        "//external/google-auth-library-java:__subpackages__",
        "//external/grpc-grpc-java:__subpackages__",
        "//external/sdk-platform-java:__subpackages__",
        "//tools/apksig",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}
