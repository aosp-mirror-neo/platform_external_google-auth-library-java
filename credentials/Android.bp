java_library_host {
    name: "google-auth-library-java-credentials",
    srcs: [
        "java/**/*.java",
    ],
    visibility: [
        "//external/google-auth-library-java:__subpackages__",
        "//external/grpc-grpc-java:__subpackages__",
        "//external/sdk-platform-java:__subpackages__",
        "//tools/apksig",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}

java_library {
    name: "google-auth-library-java-credentials-device",
    srcs: [
        "java/**/*.java",
    ],
    sdk_version: "current",
    visibility: [
        "//external/google-auth-library-java:__subpackages__",
        "//test/dts/libs/device/powerperformance/apphelpers",
    ],
}
